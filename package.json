{
  "name": "amlengine-js",
  "version": "0.3.0",
  "description": "AutomationML engine for JavaScript: CAEX 2.15 and 3.0 documents in Node and the browser, ported from Aml.Engine.",
  "license": "MIT",
  "author": "Hamied Nabizada",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hsu-aut/AmlEngine.js.git"
  },
  "homepage": "https://github.com/hsu-aut/AmlEngine.js#readme",
  "bugs": {
    "url": "https://github.com/hsu-aut/AmlEngine.js/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "typesVersions": {
    "*": {
      "services": [
        "./dist/types/services/index.d.ts"
      ],
      "*": [
        "./dist/types/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/types-cjs/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./services": {
      "import": {
        "types": "./dist/types/services/index.d.ts",
        "default": "./dist/services.js"
      },
      "require": {
        "types": "./dist/types-cjs/services/index.d.ts",
        "default": "./dist/services.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup && node scripts/build-types.mjs",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node test/browser/run.mjs",
    "oracle": "bash scripts/oracle.sh",
    "check-upstream": "node scripts/check-upstream.mjs"
  },
  "keywords": [
    "automationml",
    "aml",
    "caex",
    "iec-62714",
    "engine"
  ],
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.27.7",
    "playwright": "1.63.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
