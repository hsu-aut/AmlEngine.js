  <SuperiorStandardVersion>AutomationML 2.1</SuperiorStandardVersion>
  <SourceDocumentInformation OriginName="fpb-aml-mapper" OriginID="fpb-aml-mapper-1.0" OriginVersion="0.1.0" LastWritingDateTime="2026-07-29T00:15:57.9988413+02:00" />
  <ExternalReference Path="AutomationML_Base_Libraries_AMLEd2_2.11.0.aml" Alias="AutomationMLBaseLibrariesAMLEd22_11_0" />
  <InterfaceClassLib Name="ISO_PT_InterfaceClassLib">
    <Description>Connection endpoint interfaces for basic Place/Transition Petri nets per ISO/IEC 15909-1. In contrast to the FPD library, connections (arcs) are first-class elements: node-side and arc-side interfaces are distinct types.</Description>
    <Version>1.0.0</Version>
    <InterfaceClass Name="PT_Port" RefBaseClassPath="AutomationMLBaseLibrariesAMLEd22_11_0@AutomationMLInterfaceClassLib/AutomationMLBaseInterface/Port">
      <Description>Abstract base port for all PT connection endpoints.</Description>
      <Version>1.0.0</Version>
      <Attribute Name="PortCoordinate" AttributeDataType="xs:string" RefAttributeType="ISO_PT_DI_AttributeTypeLib/PT_Point">
        <Attribute Name="x" AttributeDataType="xs:double" />
        <Attribute Name="y" AttributeDataType="xs:double" />
      </Attribute>
    </InterfaceClass>
    <InterfaceClass Name="PT_NodeArcEnd" RefBaseClassPath="ISO_PT_InterfaceClassLib/PT_Port">
      <Description>Connection endpoint on a place or transition (the node side of an arc-node coupling). Nodes carry one PT_NodeArcEnd per incident arc.</Description>
      <Version>1.0.0</Version>
    </InterfaceClass>
    <InterfaceClass Name="PT_ArcSource" RefBaseClassPath="ISO_PT_InterfaceClassLib/PT_Port">
      <Description>Source endpoint of an arc. Links via InternalLink to a PT_NodeArcEnd on the source place or transition.</Description>
      <Version>1.0.0</Version>
    </InterfaceClass>
    <InterfaceClass Name="PT_ArcTarget" RefBaseClassPath="ISO_PT_InterfaceClassLib/PT_Port">
      <Description>Target endpoint of an arc. Links via InternalLink to a PT_NodeArcEnd on the target place or transition.</Description>
      <Version>1.0.0</Version>
    </InterfaceClass>
  </InterfaceClassLib>
  <RoleClassLib Name="ISO_PT_RoleClassLib">
    <Description>Semantic model of basic Place/Transition Petri nets per ISO/IEC 15909-1. Flat inheritance; three concrete element types (Place, Transition, Arc), one container role (Net).</Description>
    <Version>1.0.0</Version>
    <RoleClass Name="PT_Net" RefBaseClassPath="AutomationMLBaseLibrariesAMLEd22_11_0@AutomationMLBaseRoleClassLib/AutomationMLBaseRole/Structure">
      <Description>Petri net (ISO/IEC 15909-1, Sec. 4). Aggregates places, transitions, and arcs of one diagram.</Description>
      <Version>1.0.0</Version>
      <Attribute Name="refObj" AttributeDataType="xs:IDREF" RefAttributeType="AutomationML_ObjectReferences_AttributeTypeLib/refObj">
        <Description>Generic reference attribute for cross-diagram or cross-language references at net level.</Description>
      </Attribute>
    </RoleClass>
    <RoleClass Name="PT_Element" RefBaseClassPath="AutomationMLBaseLibrariesAMLEd22_11_0@AutomationMLBaseRoleClassLib/AutomationMLBaseRole">
      <Description>Abstract base for all first-class PT elements (Place, Transition, Arc). Carries identification and diagram interchange information shared by all elements.</Description>
      <Version>1.0.0</Version>
      <Attribute Name="Identification" AttributeDataType="xs:string" RefAttributeType="ISO_PT_AttributeTypeLib/PT_Identification">
        <Attribute Name="uniqueIdent" AttributeDataType="xs:string" />
        <Attribute Name="name" AttributeDataType="xs:string" />
      </Attribute>
      <Attribute Name="ViewInformation" AttributeDataType="xs:string" RefAttributeType="ISO_PT_DI_AttributeTypeLib/PT_Bounds">
        <Attribute Name="position" AttributeDataType="xs:string" RefAttributeType="ISO_PT_DI_AttributeTypeLib/PT_Point">
          <Attribute Name="x" AttributeDataType="xs:double" />
          <Attribute Name="y" AttributeDataType="xs:double" />
        </Attribute>
        <Attribute Name="width" AttributeDataType="xs:double" />
        <Attribute Name="height" AttributeDataType="xs:double" />
      </Attribute>
    </RoleClass>
    <RoleClass Name="PT_Place" RefBaseClassPath="ISO_PT_RoleClassLib/PT_Element">
      <Description>Place (ISO/IEC 15909-1, Sec. 4.1). Passive node type; may carry an initial marking.</Description>
      <Version>1.0.0</Version>
      <Attribute Name="InitialMarking" AttributeDataType="xs:nonNegativeInteger">
        <Description>Static initial marking (non-negative integer). Default 0.</Description>
        <DefaultValue>0</DefaultValue>
      </Attribute>
    </RoleClass>
    <RoleClass Name="PT_Transition" RefBaseClassPath="ISO_PT_RoleClassLib/PT_Element">
      <Description>Transition (ISO/IEC 15909-1, Sec. 4.2). Active node type representing a firing event.</Description>
      <Version>1.0.0</Version>
    </RoleClass>
    <RoleClass Name="PT_Arc" RefBaseClassPath="ISO_PT_RoleClassLib/PT_Element">
      <Description>Arc (ISO/IEC 15909-1, Sec. 4.3). Directed connection between a place and a transition. First-class element with own identity, weight, and graphical representation.</Description>
      <Version>1.0.0</Version>
      <Attribute Name="Weight" AttributeDataType="xs:positiveInteger">
        <Description>Arc weight (positive integer). Default 1.</Description>
        <DefaultValue>1</DefaultValue>
      </Attribute>
    </RoleClass>
  </RoleClassLib>
  <SystemUnitClassLib Name="ISO_PT_SystemUnitClassLib">
    <Description>Instantiation templates for the PT domain library. Mirrors the RoleClass hierarchy; each template references its role class via SupportedRoleClass, following the semantics/instantiation separation established in the FPD library.</Description>
    <Version>1.0.0</Version>
    <SystemUnitClass Name="PT_Net" ID="c1a8d000-0001-4000-8000-000000000001">
