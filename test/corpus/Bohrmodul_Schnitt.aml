  <InstanceHierarchy Name="IH_Anlagenstruktur" ID="{ff23bdd8-7d6a-5bf4-bafd-2a292599f224}">
    <Description>Anlagenstruktur der MPS 500-FMS. In der Breite vollstaendig, in der Tiefe nur dort aufgeloest, wo die Geschichte spielt: im Bohrmodul.</Description>
    <Version>0.1.0</Version>
    <InternalElement Name="PL01_LearningFactory" ID="{9ea9d3c8-087e-59fb-8309-7e7b193728aa}">
      <Description>Anlagenstandort der Lernfabrik.</Description>
      <InternalElement Name="LN10_MPS500_FMS" ID="{74578b6c-c4d1-56f0-8e59-7dd23949ab70}">
        <Description>Verkettete Fertigungslinie MPS 500-FMS zur Montage eines Pneumatikzylinders.</Description>
        <Attribute Name="Manufacturer" AttributeDataType="xs:string">
          <Value>Festo Didactic</Value>
        </Attribute>
        <Attribute Name="TypeDesignation" AttributeDataType="xs:string">
