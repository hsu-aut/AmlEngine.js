  </InstanceHierarchy>
  <InterfaceClassLib Name="ISO_PT_InterfaceClassLib">
    <Description>Connection endpoint interfaces for basic Place/Transition Petri nets per ISO/IEC 15909-1. In contrast to the FPD library, connections (arcs) are elements with an identity of their own: node-side and arc-side interfaces are distinct types.</Description>
    <Version>0.3.0</Version>
    <InterfaceClass Name="PT_Port" RefBaseClassPath="AutomationMLBaseLibrariesAMLEd22_11_0@AutomationMLInterfaceClassLib/AutomationMLBaseInterface/Port">
      <Description>Abstract base port for all PT connection endpoints.</Description>
      <Version>1.0.0</Version>
      <Attribute Name="PortCoordinate" AttributeDataType="xs:string" RefAttributeType="OMG_DD_AttributeTypeLib/DD_Point">
        <Attribute Name="x" AttributeDataType="xs:double" />
        <Attribute Name="y" AttributeDataType="xs:double" />
      </Attribute>
    </InterfaceClass>
    <InterfaceClass Name="PT_NodeArcEnd" RefBaseClassPath="ISO_PT_InterfaceClassLib/PT_Port">
      <Description>Connection endpoint on a place or transition (the node side of an arc-node coupling). Nodes carry one PT_NodeArcEnd per incident arc.</Description>
      <Version>1.0.0</Version>
    </InterfaceClass>
    <InterfaceClass Name="PT_ArcSource" RefBaseClassPath="ISO_PT_InterfaceClassLib/PT_Port">
      <Description>Source endpoint of an arc. Links via InternalLink to a PT_NodeArcEnd on the source place or transition.</Description>
      <Version>1.0.0</Version>
    </InterfaceClass>
    <InterfaceClass Name="PT_ArcTarget" RefBaseClassPath="ISO_PT_InterfaceClassLib/PT_Port">
      <Description>Target endpoint of an arc. Links via InternalLink to a PT_NodeArcEnd on the target place or transition.</Description>
      <Version>1.0.0</Version>
    </InterfaceClass>
  </InterfaceClassLib>
  <RoleClassLib Name="ISO_PT_RoleClassLib">
    <Description>Semantic model of basic Place/Transition Petri nets per ISO/IEC 15909-1. Flat inheritance; three concrete element types (Place, Transition, Arc), one container role (Net).</Description>
    <Version>0.3.0</Version>
    <RoleClass Name="PT_Net" RefBaseClassPath="AutomationMLBaseLibrariesAMLEd22_11_0@AutomationMLBaseRoleClassLib/AutomationMLBaseRole/Structure">
      <Description>Petri net (ISO/IEC 15909-1, Sec. 4). Aggregates places, transitions, and arcs of one diagram.</Description>
      <Version>1.0.0</Version>
      <Attribute Name="Identification" AttributeDataType="xs:string" RefAttributeType="ISO_PT_AttributeTypeLib/PT_Identification">
        <Description>Identification of the net (PNML net id and name).</Description>
        <Attribute Name="id" AttributeDataType="xs:string" />
        <Attribute Name="name" AttributeDataType="xs:string" />
      </Attribute>
      <Attribute Name="refObj" AttributeDataType="xs:IDREF" RefAttributeType="AutomationML_ObjectReferences_AttributeTypeLib/refObj">
        <Description>Generic reference attribute for cross-diagram or cross-language references at net level.</Description>
      </Attribute>
    </RoleClass>
    <RoleClass Name="PT_Element" RefBaseClassPath="AutomationMLBaseLibrariesAMLEd22_11_0@AutomationMLBaseRoleClassLib/AutomationMLBaseRole">
      <Description>Abstract base for all PT elements (Place, Transition, Arc). Carries identification and diagram interchange information shared by all elements.</Description>
      <Version>1.0.0</Version>
      <Attribute Name="Identification" AttributeDataType="xs:string" RefAttributeType="ISO_PT_AttributeTypeLib/PT_Identification">
        <Attribute Name="id" AttributeDataType="xs:string" />
        <Attribute Name="name" AttributeDataType="xs:string" />
      </Attribute>
      <Attribute Name="ViewInformation" AttributeDataType="xs:string" RefAttributeType="OMG_DD_AttributeTypeLib/DD_Bounds">
        <Attribute Name="position" AttributeDataType="xs:string" RefAttributeType="OMG_DD_AttributeTypeLib/DD_Point">
          <Attribute Name="x" AttributeDataType="xs:double" />
          <Attribute Name="y" AttributeDataType="xs:double" />
        </Attribute>
        <Attribute Name="width" AttributeDataType="xs:double" />
        <Attribute Name="height" AttributeDataType="xs:double" />
      </Attribute>
    </RoleClass>
    <RoleClass Name="PT_Place" RefBaseClassPath="ISO_PT_RoleClassLib/PT_Element">
      <Description>Place (ISO/IEC 15909-1, Sec. 4.1). Passive node type; may carry an initial marking.</Description>
      <Version>1.0.0</Version>
      <Attribute Name="InitialMarking" AttributeDataType="xs:nonNegativeInteger">
        <Description>Static initial marking (non-negative integer). Default 0.</Description>
        <DefaultValue>0</DefaultValue>
      </Attribute>
    </RoleClass>
    <RoleClass Name="PT_Transition" RefBaseClassPath="ISO_PT_RoleClassLib/PT_Element">
      <Description>Transition (ISO/IEC 15909-1, Sec. 4.2). Active node type representing a firing event.</Description>
      <Version>1.0.0</Version>
    </RoleClass>
    <RoleClass Name="PT_Arc" RefBaseClassPath="ISO_PT_RoleClassLib/PT_Element">
      <Description>Arc (ISO/IEC 15909-1, Sec. 4.3). Directed connection between a place and a transition. Element with an identity of its own, a weight, and a graphical representation. Routing is stored on the instance as attributes Waypoint_1..n typed OMG_DD@OMG_DD_AttributeTypeLib/DD_Waypoint, in the order from source to target. Label positions may be stored as attributes typed OMG_DD@OMG_DD_AttributeTypeLib/DD_Point (e.g. LabelOffset).</Description>
      <Version>1.0.0</Version>
      <Attribute Name="Weight" AttributeDataType="xs:positiveInteger">
        <Description>Arc weight (positive integer). Default 1.</Description>
        <DefaultValue>1</DefaultValue>
      </Attribute>
    </RoleClass>
  </RoleClassLib>
  <SystemUnitClassLib Name="ISO_PT_SystemUnitClassLib">
    <Description>Instantiation templates for the PT domain library. Mirrors the RoleClass hierarchy; each template references its role class via SupportedRoleClass, following the semantics/instantiation separation established in the FPD library.</Description>
    <Version>0.3.0</Version>
    <SystemUnitClass Name="PT_Net" ID="c1a8d000-0001-4000-8000-000000000001">
      <Version>1.0.0</Version>
      <Attribute Name="Identification" AttributeDataType="xs:string" RefAttributeType="ISO_PT_AttributeTypeLib/PT_Identification">
        <Attribute Name="id" AttributeDataType="xs:string" />
        <Attribute Name="name" AttributeDataType="xs:string" />
      </Attribute>
      <Attribute Name="refObj" AttributeDataType="xs:IDREF" RefAttributeType="AutomationML_ObjectReferences_AttributeTypeLib/refObj" />
      <SupportedRoleClass RefRoleClassPath="ISO_PT_RoleClassLib/PT_Net" />
      <SupportedRoleClass RefRoleClassPath="AutomationMLBaseLibrariesAMLEd22_11_0@AutomationMLBaseRoleClassLib/AutomationMLBaseRole/Structure" />
    </SystemUnitClass>
    <SystemUnitClass Name="PT_Element" ID="c1a8d000-0001-4000-8000-000000000002">
      <Version>1.0.0</Version>
      <Attribute Name="Identification" AttributeDataType="xs:string" RefAttributeType="ISO_PT_AttributeTypeLib/PT_Identification">
        <Attribute Name="id" AttributeDataType="xs:string" />
        <Attribute Name="name" AttributeDataType="xs:string" />
      </Attribute>
      <Attribute Name="ViewInformation" AttributeDataType="xs:string" RefAttributeType="OMG_DD_AttributeTypeLib/DD_Bounds">
        <Attribute Name="position" AttributeDataType="xs:string" RefAttributeType="OMG_DD_AttributeTypeLib/DD_Point">
          <Attribute Name="x" AttributeDataType="xs:double" />
          <Attribute Name="y" AttributeDataType="xs:double" />
        </Attribute>
        <Attribute Name="width" AttributeDataType="xs:double" />
        <Attribute Name="height" AttributeDataType="xs:double" />
      </Attribute>
      <SupportedRoleClass RefRoleClassPath="ISO_PT_RoleClassLib/PT_Element" />
    </SystemUnitClass>
    <SystemUnitClass Name="PT_Place" ID="c1a8d000-0001-4000-8000-000000000003" RefBaseClassPath="ISO_PT_SystemUnitClassLib/PT_Element">
      <Version>1.0.0</Version>
      <Attribute Name="InitialMarking" AttributeDataType="xs:nonNegativeInteger">
        <DefaultValue>0</DefaultValue>
      </Attribute>
      <SupportedRoleClass RefRoleClassPath="ISO_PT_RoleClassLib/PT_Place" />
    </SystemUnitClass>
    <SystemUnitClass Name="PT_Transition" ID="c1a8d000-0001-4000-8000-000000000004" RefBaseClassPath="ISO_PT_SystemUnitClassLib/PT_Element">
      <Version>1.0.0</Version>
      <SupportedRoleClass RefRoleClassPath="ISO_PT_RoleClassLib/PT_Transition" />
    </SystemUnitClass>
    <SystemUnitClass Name="PT_Arc" ID="c1a8d000-0001-4000-8000-000000000005" RefBaseClassPath="ISO_PT_SystemUnitClassLib/PT_Element">
      <Version>1.0.0</Version>
      <Attribute Name="Weight" AttributeDataType="xs:positiveInteger">
        <DefaultValue>1</DefaultValue>
      </Attribute>
      <SupportedRoleClass RefRoleClassPath="ISO_PT_RoleClassLib/PT_Arc" />
    </SystemUnitClass>
  </SystemUnitClassLib>
  <AttributeTypeLib Name="ISO_PT_AttributeTypeLib">
    <Description>Information-model attribute types for PT nets. Kept intentionally minimal to reflect the small ontology of ISO/IEC 15909-1 (as opposed to VDI 3682 Part 2, which specifies a richer information model).</Description>
    <Version>0.3.0</Version>
    <AttributeType Name="PT_Identification" AttributeDataType="xs:string">
      <Description>Identification of a PT element. Corresponds to the PNML object identification per ISO/IEC 15909-2: id maps to the PNML id attribute, name maps to the PNML name label.</Description>
      <Version>1.0.0</Version>
      <Attribute Name="id" AttributeDataType="xs:string" />
      <Attribute Name="name" AttributeDataType="xs:string" />
    </AttributeType>
  </AttributeTypeLib>
  <AttributeTypeLib Name="OMG_DD_AttributeTypeLib">
    <Description>Language-agnostic diagram-interchange attribute types, structured after the OMG Diagram Definition (DD) specification: DD_Bounds (DC::Bounds), DD_Point (DC::Point), DD_Waypoint (DI::Waypoint). Referenced by the VDI_FPD and ISO_PT domain libraries.</Description>
    <Version>0.1.0</Version>
    <AttributeType Name="DD_Bounds" AttributeDataType="xs:string">
      <Description>A rectangular area defined by a top-left (x, y) location and a size (width, height) along the x-y axes (cf. DC::Bounds).</Description>
      <Version>0.1.0</Version>
      <Attribute Name="position" AttributeDataType="xs:string" RefAttributeType="OMG_DD_AttributeTypeLib/DD_Point">
        <Attribute Name="x" AttributeDataType="xs:double" />
        <Attribute Name="y" AttributeDataType="xs:double" />
      </Attribute>
      <Attribute Name="width" AttributeDataType="xs:double" />
      <Attribute Name="height" AttributeDataType="xs:double" />
    </AttributeType>
    <AttributeType Name="DD_Waypoint" AttributeDataType="xs:string">
      <Description>A routing point along a connection path (cf. DI::Waypoint).</Description>
      <Version>0.1.0</Version>
      <Attribute Name="position" AttributeDataType="xs:string" RefAttributeType="OMG_DD_AttributeTypeLib/DD_Point">
        <Attribute Name="x" AttributeDataType="xs:double" />
        <Attribute Name="y" AttributeDataType="xs:double" />
      </Attribute>
    </AttributeType>
    <AttributeType Name="DD_Point" AttributeDataType="xs:string">
      <Description>A two-dimensional point in a coordinate system (cf. DC::Point).</Description>
      <Version>0.1.0</Version>
      <Attribute Name="x" AttributeDataType="xs:double" />
      <Attribute Name="y" AttributeDataType="xs:double" />
    </AttributeType>
  </AttributeTypeLib>
  <AttributeTypeLib Name="AutomationML_ObjectReferences_AttributeTypeLib" ID="207a2f21-f41a-47f7-b8a7-1e640cad289c">
    <Description>Library of object reference types</Description>
    <Version>1.1.1-beta</Version>
    <AttributeType Name="refObj" ID="6bfeebe7-d1f4-4085-b34d-dea400a87740" AttributeDataType="xs:IDREF">
      <Description>refObj is an abstract attribute type for modelling object references. Its value references another AML object, its semantic is unspecific. Derived reference attribute types specify the semantic meaning of the relationship, such as identity, aspect, abstraction, or refinement.</Description>
      <Version>1.0.0</Version>
    </AttributeType>
    <AttributeType Name="refBaseObj" ID="94df107c-15e4-4381-92c1-b0ad8043d19d" AttributeDataType="xs:IDREF" RefAttributeType="AutomationML_ObjectReferences_AttributeTypeLib/refObj">
      <Description>refBaseObj is an attribute type attached to an aspect object. Its value shall reference the corresponding base object. The aspect object and the referenced base object represent the same logical object while containing complementary information. This mechanism enables distributed modelling of logical objects across different hierarchies, contexts, ownership boundaries, and aspects. </Description>
      <Version>1.0.0</Version>
    </AttributeType>
    <AttributeType Name="refAspectObj" ID="629175a1-9813-4678-a6aa-0d8d278c0f01" AttributeDataType="xs:IDREF" RefAttributeType="AutomationML_ObjectReferences_AttributeTypeLib/refObj">
      <Description>refAspectObj is an attribute type attached to a base object. Its value shall reference an aspect object representing the same logical object. The attribute is optional and provides a reverse reference to distributed aspect representations. It facilitates discovery and navigation of complementary object descriptions without changing the semantic relationship established by the corresponding refBaseObj reference.</Description>
      <Version>1.0.0</Version>
    </AttributeType>
    <AttributeType Name="refDetailObj" ID="223848cc-78a2-47f9-b593-3f86a1bccf7d" AttributeDataType="xs:IDREF" RefAttributeType="AutomationML_ObjectReferences_AttributeTypeLib/refObj">
      <Description>refDetailObj is an attribute type attached to an abstract object. Its value references a distinct object that provides a more detailed representation of the same subject, typically including its internal structure or subordinate objects. The referenced object may have a different type and may be located in another hierarchy.</Description>
      <Version>1.0.0</Version>
    </AttributeType>
    <AttributeType Name="refAbstractObj" ID="7dc12b9e-70fe-4c48-90a9-39a632419530" AttributeDataType="xs:IDREF" RefAttributeType="AutomationML_ObjectReferences_AttributeTypeLib/refObj">
      <Description>refAbstractObj is an attribute type attached to a detail object. Its value references the distinct object that represents the same subject at a higher level of abstraction. The referenced object may have a different type and may be located in another hierarchy.</Description>
      <Version>1.0.0</Version>
    </AttributeType>
  </AttributeTypeLib>
</CAEXFile>