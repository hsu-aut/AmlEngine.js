      <Version>1.0.0</Version>
      <Attribute Name="Category" AttributeDataType="xs:string" RefAttributeType="VDI_FPD_AttributeTypeLib/FPD_Identification">
        <Attribute Name="uniqueIdent" AttributeDataType="xs:string" />
        <Attribute Name="longName" AttributeDataType="xs:string" />
        <Attribute Name="shortName" AttributeDataType="xs:string" />
        <Attribute Name="versionNumber" AttributeDataType="xs:string" />
        <Attribute Name="revisionNumber" AttributeDataType="xs:string" />
      </Attribute>
      <Attribute Name="DescriptiveElement" AttributeDataType="xs:string">
        <Attribute Name="valueDeterminationProcess" AttributeDataType="xs:string" />
        <Attribute Name="representivity" AttributeDataType="xs:string" />
        <Attribute Name="setpointValue" AttributeDataType="xs:string">
          <Attribute Name="value" AttributeDataType="xs:string" />
          <Attribute Name="unit" AttributeDataType="xs:string" />
        </Attribute>
        <Attribute Name="validityLimits" AttributeDataType="xs:string">
          <Attribute Name="validityLimit" AttributeDataType="xs:string">
            <Attribute Name="limitType" AttributeDataType="xs:string" />
