  <InstanceHierarchy Name="MPS500_PlantStructure" ID="{1e011154-e47a-51e0-a0fc-e07b5a8b658f}">
    <Description>Klassische AML-Anlagenstruktur der MPS 500-FMS: Anlage &gt; Linie &gt; Station &gt; Modul &gt; Geraet. Die Aufteilung in Module und Geraete ist eine dokumentierte Annahme und gegen die reale Ausbaustufe zu pruefen.</Description>
    <Version>0.1.0</Version>
    <InternalElement Name="PL01_LearningFactory" ID="{57889811-8a33-5c28-84c3-b40c1d8735a0}" RefBaseSystemUnitPath="MPS500_SystemUnitClassLib/Plant">
      <Description>Anlagenstandort, in dem die MPS 500-FMS betrieben wird.</Description>
      <Attribute Name="SiteDesignation" AttributeDataType="xs:string">
        <Value>Lernfabrik</Value>
      </Attribute>
      <Attribute Name="Location" AttributeDataType="xs:string">
        <Value>n.a.</Value>
      </Attribute>
      <InternalElement Name="LN10_MPS500_FMS" ID="{742d83a3-80b4-5c87-9352-cbedfa846dbf}" RefBaseSystemUnitPath="MPS500_SystemUnitClassLib/ProductionLine">
        <Description>Verkettete Fertigungslinie zur Montage eines Pneumatikzylinders.</Description>
        <Attribute Name="Manufacturer" AttributeDataType="xs:string">
          <Value>Festo Didactic</Value>
        </Attribute>
        <Attribute Name="TypeDesignation" AttributeDataType="xs:string">
          <Value>MPS 500-FMS</Value>
        </Attribute>
        <Attribute Name="StationCount" AttributeDataType="xs:string">
          <Value>5</Value>
        </Attribute>
        <Attribute Name="CommissioningYear" AttributeDataType="xs:string">
          <Value>n.a.</Value>
        </Attribute>
        <ExternalInterface Name="ResourceCoupling" ID="{844568c0-a710-588d-8116-0cea7e866106}" RefBaseClassPath="MPS500_InterfaceClassLib/ResourceCoupling">
          <Description>Kopplungspunkt zur fpb:TechnicalResource T_MPS500_FMS des FPD-Prozessmodells.</Description>
        </ExternalInterface>
        <InternalElement Name="ST10_Distributing" ID="{c0313bf3-4419-568d-b6dd-02523cab64c6}" RefBaseSystemUnitPath="MPS500_SystemUnitClassLib/DistributingStation">
          <Description>Vereinzelt Zylindergehaeuse aus dem Stapelmagazin und uebergibt sie an das Transfersystem.</Description>
          <Attribute Name="StationNumber" AttributeDataType="xs:string">
            <Value>10</Value>
          </Attribute>
          <Attribute Name="Manufacturer" AttributeDataType="xs:string">
            <Value>Festo Didactic</Value>
          </Attribute>
          <Attribute Name="TypeDesignation" AttributeDataType="xs:string">
            <Value>Station Verteilen</Value>
          </Attribute>
          <Attribute Name="SupplyVoltage_V" AttributeDataType="xs:string">
            <Value>24</Value>
          </Attribute>
          <Attribute Name="SupplyPressure_bar" AttributeDataType="xs:string">
            <Value>6</Value>
          </Attribute>
          <ExternalInterface Name="ResourceCoupling" ID="{8743c21a-7663-585b-9133-4578bc687389}" RefBaseClassPath="MPS500_InterfaceClassLib/ResourceCoupling">
            <Description>Kopplungspunkt zur fpb:TechnicalResource T_Station_Distributing des FPD-Prozessmodells.</Description>
