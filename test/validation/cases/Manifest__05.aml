      </InterfaceClass>
      <InterfaceClass Name="MassFlowConnector" RefBaseClassPath="MTPHMIICLib/ConnectorInterface">
        <Description>Connection point for internal links between two different Nozzles</Description>
      </InterfaceClass>
    </InterfaceClass>
  </InterfaceClassLib>
