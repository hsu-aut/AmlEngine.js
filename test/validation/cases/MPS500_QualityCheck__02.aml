    </InterfaceClass>
    <InterfaceClass Name="FPD_Usage" RefBaseClassPath="VDI_FPD_InterfaceClassLib/FPD_Port">
      <Version>1.2.0</Version>
    </InterfaceClass>
    <InterfaceClass Name="FPD_ParallelFlowIn" RefBaseClassPath="VDI_FPD_InterfaceClassLib/FPD_Port">
      <Version>1.2.0</Version>
    </InterfaceClass>
    <InterfaceClass Name="FPD_ParallelFlowOut" RefBaseClassPath="VDI_FPD_InterfaceClassLib/FPD_Port">
      <Version>1.2.0</Version>
    </InterfaceClass>
    <InterfaceClass Name="FPD_AlternativeFlowIn" RefBaseClassPath="VDI_FPD_InterfaceClassLib/FPD_Port">
      <Version>1.2.0</Version>
    </InterfaceClass>
    <InterfaceClass Name="FPD_AlternativeFlowOut" RefBaseClassPath="VDI_FPD_InterfaceClassLib/FPD_Port">
      <Version>1.2.0</Version>
    </InterfaceClass>
  </InterfaceClassLib>
  <InterfaceClassLib Name="ISO_PT_InterfaceClassLib">
    <Description>Connection endpoint interfaces for basic Place/Transition Petri nets per ISO/IEC 15909-1. In contrast to the FPD library, connections (arcs) are elements with an identity of their own: node-side and arc-side interfaces are distinct types.</Description>
    <Version>1.0.0</Version>
    <InterfaceClass Name="PT_Port" RefBaseClassPath="AutomationMLBaseLibrariesAMLEd22_11_0@AutomationMLInterfaceClassLib/AutomationMLBaseInterface/Port">
      <Description>Abstract base port for all PT connection endpoints.</Description>
      <Version>1.0.0</Version>
      <Attribute Name="PortCoordinate" AttributeDataType="xs:string" RefAttributeType="OMG_DD_AttributeTypeLib/DD_Point">
        <Attribute Name="x" AttributeDataType="xs:double" />
        <Attribute Name="y" AttributeDataType="xs:double" />
      </Attribute>
    </InterfaceClass>
    <InterfaceClass Name="PT_NodeArcEnd" RefBaseClassPath="ISO_PT_InterfaceClassLib/PT_Port">
      <Description>Connection endpoint on a place or transition (the node side of an arc-node coupling). Nodes carry one PT_NodeArcEnd per incident arc.</Description>
      <Version>1.0.0</Version>
    </InterfaceClass>
    <InterfaceClass Name="PT_ArcSource" RefBaseClassPath="ISO_PT_InterfaceClassLib/PT_Port">
      <Description>Source endpoint of an arc. Links via InternalLink to a PT_NodeArcEnd on the source place or transition.</Description>
      <Version>1.0.0</Version>
    </InterfaceClass>
    <InterfaceClass Name="PT_ArcTarget" RefBaseClassPath="ISO_PT_InterfaceClassLib/PT_Port">
      <Description>Target endpoint of an arc. Links via InternalLink to a PT_NodeArcEnd on the target place or transition.</Description>
      <Version>1.0.0</Version>
    </InterfaceClass>
  </InterfaceClassLib>
  <RoleClassLib Name="VDI_FPD_RoleClassLib">
    <Description>Semantic model of the FPD per VDI/VDE 3682. Flat layout with explicit inheritance via RefBaseClassPath.</Description>
    <Version>1.2.0</Version>
    <RoleClass Name="FPD_Process" RefBaseClassPath="AutomationMLBaseLibrariesAMLEd22_11_0@AutomationMLBaseRoleClassLib/AutomationMLBaseRole/Structure">
      <Description>Process (Part 2, Fig. 2). Aggregates states (2..*), system limit (1), and process operators (1..*).</Description>
      <Version>1.2.0</Version>
      <Attribute Name="refObj" AttributeDataType="xs:IDREF" RefAttributeType="AutomationML_ObjectReferences_AttributeTypeLib/refAbstractObj">
        <Description>Reference to the parent process operator whose decomposition this process represents (refAbstractObj: this process is the detail representation of the operator).</Description>
      </Attribute>
    </RoleClass>
    <RoleClass Name="FPD_SystemLimit">
      <Description>System limit (Part 1, p. 9). Peer aggregate of the process, not a container.</Description>
      <Version>1.2.0</Version>
      <Attribute Name="Identification" AttributeDataType="xs:string" RefAttributeType="VDI_FPD_AttributeTypeLib/FPD_Identification">
        <Attribute Name="uniqueIdent" AttributeDataType="xs:string" />
        <Attribute Name="longName" AttributeDataType="xs:string" />
        <Attribute Name="shortName" AttributeDataType="xs:string" />
        <Attribute Name="versionNumber" AttributeDataType="xs:string" />
        <Attribute Name="revisionNumber" AttributeDataType="xs:string" />
      </Attribute>
      <Attribute Name="ViewInformation" AttributeDataType="xs:string" RefAttributeType="OMG_DD_AttributeTypeLib/DD_Bounds">
        <Attribute Name="position" AttributeDataType="xs:string" RefAttributeType="OMG_DD_AttributeTypeLib/DD_Point">
          <Attribute Name="x" AttributeDataType="xs:double" />
          <Attribute Name="y" AttributeDataType="xs:double" />
        </Attribute>
        <Attribute Name="width" AttributeDataType="xs:double" />
        <Attribute Name="height" AttributeDataType="xs:double" />
      </Attribute>
    </RoleClass>
    <RoleClass Name="FPD_Object" RefBaseClassPath="AutomationMLBaseLibrariesAMLEd22_11_0@AutomationMLBaseRoleClassLib/AutomationMLBaseRole">
      <Description>Abstract base for all FPB objects (Part 1, p. 4: product, energy, information, process operator, technical resource).</Description>
      <Version>1.2.0</Version>
      <Attribute Name="Identification" AttributeDataType="xs:string" RefAttributeType="VDI_FPD_AttributeTypeLib/FPD_Identification">
        <Attribute Name="uniqueIdent" AttributeDataType="xs:string" />
        <Attribute Name="longName" AttributeDataType="xs:string" />
        <Attribute Name="shortName" AttributeDataType="xs:string" />
        <Attribute Name="versionNumber" AttributeDataType="xs:string" />
        <Attribute Name="revisionNumber" AttributeDataType="xs:string" />
      </Attribute>
      <Attribute Name="Characteristics" AttributeDataType="xs:string">
        <Description>Container for characteristics (Part 2, Fig. 3).</Description>
      </Attribute>
      <Attribute Name="ViewInformation" AttributeDataType="xs:string" RefAttributeType="OMG_DD_AttributeTypeLib/DD_Bounds">
        <Attribute Name="position" AttributeDataType="xs:string" RefAttributeType="OMG_DD_AttributeTypeLib/DD_Point">
          <Attribute Name="x" AttributeDataType="xs:double" />
          <Attribute Name="y" AttributeDataType="xs:double" />
        </Attribute>
        <Attribute Name="width" AttributeDataType="xs:double" />
        <Attribute Name="height" AttributeDataType="xs:double" />
      </Attribute>
    </RoleClass>
    <RoleClass Name="FPD_State" RefBaseClassPath="VDI_FPD_RoleClassLib/FPD_Object">
      <Description>Abstract state (Part 2, Fig. 2). Inherits Identification and Characteristics from FPD_Object.</Description>
      <Version>1.2.0</Version>
      <Attribute Name="refObj" AttributeDataType="xs:IDREF" RefAttributeType="AutomationML_ObjectReferences_AttributeTypeLib/refBaseObj">
        <Description>Reference to the original state instance that this boundary state represents (refBaseObj: same logical object, complementary view). Always points to the top-level original, regardless of decomposition depth.</Description>
      </Attribute>
    </RoleClass>
    <RoleClass Name="FPD_Product" RefBaseClassPath="VDI_FPD_RoleClassLib/FPD_State">
      <Version>1.2.0</Version>
    </RoleClass>
    <RoleClass Name="FPD_Energy" RefBaseClassPath="VDI_FPD_RoleClassLib/FPD_State">
      <Version>1.2.0</Version>
    </RoleClass>
    <RoleClass Name="FPD_Information" RefBaseClassPath="VDI_FPD_RoleClassLib/FPD_State">
      <Version>1.2.0</Version>
    </RoleClass>
    <RoleClass Name="FPD_ProcessOperator" RefBaseClassPath="VDI_FPD_RoleClassLib/FPD_Object">
      <Description>Process operator (Part 2, Fig. 2). Inherits Identification and Characteristics from FPD_Object.</Description>
      <Version>1.2.0</Version>
      <Attribute Name="refProcess" AttributeDataType="xs:IDREF" RefAttributeType="AutomationML_ObjectReferences_AttributeTypeLib/refDetailObj">
        <Description>Reference to the child process that decomposes this operator (refDetailObj: the child process is the more detailed representation). Empty if the operator is not further decomposed.</Description>
      </Attribute>
    </RoleClass>
    <RoleClass Name="FPD_TechnicalResource" RefBaseClassPath="VDI_FPD_RoleClassLib/FPD_Object">
      <Description>Technical resource (Part 1, p. 9). Located outside the system limit, associated via usage.</Description>
      <Version>1.2.0</Version>
    </RoleClass>
  </RoleClassLib>
  <RoleClassLib Name="ISO_PT_RoleClassLib">
    <Description>Semantic model of basic Place/Transition Petri nets per ISO/IEC 15909-1. Flat inheritance; three concrete element types (Place, Transition, Arc), one container role (Net).</Description>
    <Version>1.0.0</Version>
    <RoleClass Name="PT_Net" RefBaseClassPath="AutomationMLBaseLibrariesAMLEd22_11_0@AutomationMLBaseRoleClassLib/AutomationMLBaseRole/Structure">
      <Description>Petri net (ISO/IEC 15909-1, Sec. 4). Aggregates places, transitions, and arcs of one diagram.</Description>
      <Version>1.0.0</Version>
      <Attribute Name="Identification" AttributeDataType="xs:string" RefAttributeType="ISO_PT_AttributeTypeLib/PT_Identification">
        <Description>Identification of the net (PNML net id and name).</Description>
        <Attribute Name="id" AttributeDataType="xs:string" />
        <Attribute Name="name" AttributeDataType="xs:string" />
      </Attribute>
      <Attribute Name="refObj" AttributeDataType="xs:IDREF" RefAttributeType="AutomationML_ObjectReferences_AttributeTypeLib/refObj">
        <Description>Generic reference attribute for cross-diagram or cross-language references at net level.</Description>
      </Attribute>
    </RoleClass>
    <RoleClass Name="PT_Element" RefBaseClassPath="AutomationMLBaseLibrariesAMLEd22_11_0@AutomationMLBaseRoleClassLib/AutomationMLBaseRole">
      <Description>Abstract base for all PT elements (Place, Transition, Arc). Carries identification and diagram interchange information shared by all elements.</Description>
      <Version>1.0.0</Version>
      <Attribute Name="Identification" AttributeDataType="xs:string" RefAttributeType="ISO_PT_AttributeTypeLib/PT_Identification">
        <Attribute Name="id" AttributeDataType="xs:string" />
        <Attribute Name="name" AttributeDataType="xs:string" />
      </Attribute>
      <Attribute Name="ViewInformation" AttributeDataType="xs:string" RefAttributeType="OMG_DD_AttributeTypeLib/DD_Bounds">
        <Attribute Name="position" AttributeDataType="xs:string" RefAttributeType="OMG_DD_AttributeTypeLib/DD_Point">
          <Attribute Name="x" AttributeDataType="xs:double" />
          <Attribute Name="y" AttributeDataType="xs:double" />
        </Attribute>
        <Attribute Name="width" AttributeDataType="xs:double" />
        <Attribute Name="height" AttributeDataType="xs:double" />
      </Attribute>
    </RoleClass>
    <RoleClass Name="PT_Place" RefBaseClassPath="ISO_PT_RoleClassLib/PT_Element">
      <Description>Place (ISO/IEC 15909-1, Sec. 4.1). Passive node type; may carry an initial marking.</Description>
      <Version>1.0.0</Version>
      <Attribute Name="InitialMarking" AttributeDataType="xs:nonNegativeInteger">
        <Description>Static initial marking (non-negative integer). Default 0.</Description>
        <DefaultValue>0</DefaultValue>
      </Attribute>
    </RoleClass>
    <RoleClass Name="PT_Transition" RefBaseClassPath="ISO_PT_RoleClassLib/PT_Element">
      <Description>Transition (ISO/IEC 15909-1, Sec. 4.2). Active node type representing a firing event.</Description>
      <Version>1.0.0</Version>
    </RoleClass>
    <RoleClass Name="PT_Arc" RefBaseClassPath="ISO_PT_RoleClassLib/PT_Element">
      <Description>Arc (ISO/IEC 15909-1, Sec. 4.3). Directed connection between a place and a transition. Element with an identity of its own, a weight, and a graphical representation. Routing is stored on the instance as attributes Waypoint_1..n typed OMG_DD_AttributeTypeLib/DD_Waypoint, in the order from source to target. Label positions may be stored as attributes typed OMG_DD_AttributeTypeLib/DD_Point (e.g. LabelOffset).</Description>
      <Version>1.0.0</Version>
      <Attribute Name="Weight" AttributeDataType="xs:positiveInteger">
        <Description>Arc weight (positive integer). Default 1.</Description>
        <DefaultValue>1</DefaultValue>
      </Attribute>
    </RoleClass>
  </RoleClassLib>
