<?xml version="1.0" encoding="utf-8"?>
<CAEXFile FileName="mirrors-215.aml" SchemaVersion="2.15" xsi:noNamespaceSchemaLocation="CAEX_ClassModel_V2.15.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <AdditionalInformation AutomationMLVersion="2.0" />
  <InstanceHierarchy Name="IH">
    <InternalElement Name="Master" ID="ie-master" RefBaseSystemUnitPath="SUCL/Machine">
      <ExternalInterface Name="Plug" ID="ei-master-plug" RefBaseClassPath="ICL/Base/Port" />
      <Attribute Name="Speed" AttributeDataType="xs:double">
        <Value>3</Value>
      </Attribute>
    </InternalElement>
    <InternalElement Name="Mirror" ID="ie-mirror" RefBaseSystemUnitPath="ie-master" />
    <InternalElement Name="MirrorOfMirror" ID="ie-mirror2" RefBaseSystemUnitPath="ie-mirror" />
    <InternalElement Name="BrokenMirror" ID="ie-mirror3" RefBaseSystemUnitPath="ie-nothing" />
    <InternalElement Name="SelfMirror" ID="ie-selfmirror" RefBaseSystemUnitPath="ie-selfmirror" />
    <InternalElement Name="Holder" ID="ie-holder">
      <ExternalInterface Name="PlugMirror" ID="ei-mirror" RefBaseClassPath="ei-master-plug" />
      <ExternalInterface Name="PlugMirror2" ID="ei-mirror2" RefBaseClassPath="ei-mirror" />
      <ExternalInterface Name="Nowhere" ID="ei-nowhere" RefBaseClassPath="ei-nothing" />
      <InternalLink Name="ML" RefPartnerSideA="ie-holder:PlugMirror" RefPartnerSideB="ie-master:Plug" />
    </InternalElement>
  </InstanceHierarchy>
  <InterfaceClassLib Name="ICL">
    <Version>1.0.0</Version>
    <InterfaceClass Name="Base">
      <Attribute Name="Direction" AttributeDataType="xs:string">
        <Value>InOut</Value>
      </Attribute>
      <InterfaceClass Name="Port" RefBaseClassPath="ICL/Base" />
      <InterfaceClass Name="Signal" RefBaseClassPath="ICL/Base/Port" />
    </InterfaceClass>
    <InterfaceClass Name="Broken" RefBaseClassPath="ICL/Missing" />
    <InterfaceClass Name="External" RefBaseClassPath="ExtLib@ExtICL/ExtInterface" />
  </InterfaceClassLib>
  <RoleClassLib Name="RCL">
    <RoleClass Name="Resource">
      <Attribute Name="Speed" AttributeDataType="xs:double" Unit="m/s">
        <DefaultValue>1.5</DefaultValue>
      </Attribute>
      <ExternalInterface Name="In" RefBaseClassPath="ICL/Base/Port" ID="rc-ei-in" />
      <RoleClass Name="Robot" RefBaseClassPath="RCL/Resource">
        <RoleClass Name="Arm" RefBaseClassPath="RCL/Resource/Robot" />
      </RoleClass>
    </RoleClass>
    <RoleClass Name="Product" />
    <RoleClass Name="Orphan" RefBaseClassPath="RCL/Nope" />
    <RoleClass Name="Ext" RefBaseClassPath="ExtLib@ExtRCL/ExtRole" />
  </RoleClassLib>
  <SystemUnitClassLib Name="SUCL">
    <SystemUnitClass Name="Machine">
      <Attribute Name="Power" AttributeDataType="xs:double" Unit="kW">
        <Value>11</Value>
        <Attribute Name="Max" AttributeDataType="xs:double">
          <Value>15</Value>
        </Attribute>
      </Attribute>
      <ExternalInterface Name="Plug" RefBaseClassPath="ICL/Base/Port" ID="suc-machine-plug" />
      <InternalElement Name="Motor" ID="suc-machine-motor" RefBaseSystemUnitPath="SUCL/Motor">
        <ExternalInterface Name="Shaft" RefBaseClassPath="ICL/Base/Port" ID="suc-motor-shaft" />
      </InternalElement>
      <InternalElement Name="Drive" ID="suc-machine-drive">
        <ExternalInterface Name="Out" RefBaseClassPath="ICL/Base/Signal" ID="suc-drive-out" />
      </InternalElement>
      <SupportedRoleClass RefRoleClassPath="RCL/Resource" />
      <InternalLink Name="L1" RefPartnerSideA="suc-machine-motor:Shaft" RefPartnerSideB="suc-machine-drive:Out" />
      <SystemUnitClass Name="Press" RefBaseClassPath="SUCL/Machine">
        <Attribute Name="Power" AttributeDataType="xs:double">
          <Value>22</Value>
        </Attribute>
        <SupportedRoleClass RefRoleClassPath="RCL/Resource/Robot" />
      </SystemUnitClass>
    </SystemUnitClass>
    <SystemUnitClass Name="Motor">
      <Attribute Name="Rpm" AttributeDataType="xs:int">
        <Value>1500</Value>
      </Attribute>
    </SystemUnitClass>
    <SystemUnitClass Name="Derived" RefBaseClassPath="SUCL/Machine/Press">
      <SupportedRoleClass RefRoleClassPath="RCL/Missing" />
    </SystemUnitClass>
    <SystemUnitClass Name="Broken" RefBaseClassPath="SUCL/Nope" />
    <SystemUnitClass Name="External" RefBaseClassPath="ExtLib@ExtSUCL/ExtClass">
      <SupportedRoleClass RefRoleClassPath="ExtLib@ExtRCL/ExtRole" />
    </SystemUnitClass>
  </SystemUnitClassLib>
</CAEXFile>
